# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental?schema=public"

# JWT
JWT_ACCESS_SECRET="cambia-este-secreto-en-produccion-min-32-chars"
JWT_REFRESH_SECRET="otro-secreto-distinto-para-refresh-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Bcrypt
BCRYPT_ROUNDS=12