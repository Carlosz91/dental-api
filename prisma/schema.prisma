generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Specialty {
  ORTODONCIA
  CIRUGIA
  ESTETICA
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
  NO_ASISTIO
}

enum AppointmentSource {
  WEB
  PHONE
  WALKIN
  ADMIN
}

enum UserRole {
  PATIENT
  STAFF
  ADMIN
  SPECIALIST
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          UserRole  @default(PATIENT)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  specialist    Specialist?
  appointments  Appointment[] @relation("PatientAppointments")
  createdAppointments Appointment[] @relation("CreatedAppointments")
  auditEvents   AuditEvent[]

  @@index([email])
  @@index([role])
}

model Specialist {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String       @unique
  specialty      Specialty
  bio            String?
  avatarUrl      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  availabilityRules AvailabilityRule[]
  appointments     Appointment[]
  blockedSlots     BlockedSlot[]

  @@index([specialty])
  @@index([isActive])
}

model AvailabilityRule {
  id              String      @id @default(uuid())
  specialistId    String
  specialist      Specialist  @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  weekday         Int         // 0=Domingo ... 6=Sábado
  startTime       String      // "08:00"
  endTime         String      // "14:00"
  slotMinutes     Int         @default(30)
  bufferMinutes   Int         @default(5)
  effectiveFrom   DateTime    @default(now())
  effectiveTo     DateTime?

  @@unique([specialistId, weekday, effectiveFrom])
  @@index([specialistId])
}

model BlockedSlot {
  id            String     @id @default(uuid())
  specialistId  String
  specialist    Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  reason        String
  createdAt     DateTime   @default(now())

  @@index([specialistId, startsAt])
}

model Appointment {
  id              String            @id @default(uuid())
  specialistId    String
  specialist      Specialist        @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  patientId       String
  patient         User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?             @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(PENDIENTE)
  specialty       Specialty
  notes           String?
  source          AppointmentSource @default(WEB)
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  auditEvents     AuditEvent[]

  @@index([specialistId, startsAt])
  @@index([patientId])
  @@index([status])
  @@index([startsAt])
}

model AuditEvent {
  id             String   @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventType      String
  oldStatus      AppointmentStatus?
  newStatus      AppointmentStatus?
  changedById    String?
  changedBy      User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt      DateTime @default(now())
  payload        Json?

  @@index([appointmentId])
  @@index([changedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tokenHash])
}